-- ================= ISOLATED SYSTEM 1: SPEED & JUMP LOGIC =================
RunService.RenderStepped:Connect(function()
	if not Config.SpeedJumpEnabled then return end

	local char = LocalPlayer.Character
	if not char then return end

	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local rootPart = char:FindFirstChild("HumanoidRootPart")
	
	if humanoid then
		humanoid.WalkSpeed = Config.WalkSpeed
		pcall(function()
			humanoid.UseJumpPower = true
			humanoid.JumpPower = Config.JumpPower
		end)
		
		if rootPart and humanoid.MoveDirection.Magnitude > 0 then
			local currentVel = rootPart.AssemblyLinearVelocity
			local targetDir = humanoid.MoveDirection
			local speedRatio = Config.WalkSpeed / 16
			
			if speedRatio > 1 then
				rootPart.AssemblyLinearVelocity = Vector3.new(
					targetDir.X * Config.WalkSpeed,
					currentVel.Y,
					targetDir.Z * Config.WalkSpeed
				)
			end
		end
	end
end)


-- ================= ISOLATED SYSTEM 2: INFINITE JUMP LOGIC =================
UserInputService.JumpRequest:Connect(function()
	if not Config.InfJumpEnabled then return end

	local char = LocalPlayer.Character
	local rootPart = char and char:FindFirstChild("HumanoidRootPart")
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")

	if rootPart and humanoid then
		local currentVel = rootPart.AssemblyLinearVelocity
		local jumpForce = math.clamp(Config.JumpPower, 50, 200)
		
		rootPart.AssemblyLinearVelocity = Vector3.new(currentVel.X, jumpForce * 0.8, currentVel.Z)
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	end
end)


-- ================= ISOLATED SYSTEM 3: ANTI-RAGDOLL LOGIC =================
RunService.Stepped:Connect(function()
	if not Config.AntiRagdollEnabled then return end

	local char = LocalPlayer.Character
	if not char then return end

	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if humanoid then
		-- Block bad states that cause ragdolling/falling
		if humanoid:GetState() == Enum.HumanoidStateType.Ragdoll or 
		   humanoid:GetState() == Enum.HumanoidStateType.FallingDown or 
		   humanoid:GetState() == Enum.HumanoidStateType.PlatformStanding then
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			humanoid.PlatformStand = false
		end
	end

	-- Automatically strip custom joints or constraints applied by ragdoll scripts
	for _, descendant in ipairs(char:GetDescendants()) do
		if descendant:IsA("BallSocketConstraint") or descendant:IsA("HingeConstraint") then
			descendant:Destroy()
		end
	end
end)


-- ================= LAG-OPTIMIZED EGG ESP LOGIC (2000m) =================
local function isValidEgg(object)
	return object:IsA("BasePart") and string.find(string.lower(object.Name), "egg") ~= nil
end

task.spawn(function()
	while true do
		task.wait(1.5)
		if not Config.ESPEnabled then continue end

		local char = LocalPlayer.Character
		local rootPart = char and char:FindFirstChild("HumanoidRootPart")
		if not rootPart then continue end

		local foundEggs = {}
		
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if isValidEgg(obj) then
				local dist = (rootPart.Position - obj.Position).Magnitude
				if dist <= Config.MaxDistance then
					foundEggs[obj] = dist
				end
			end
		end

		for obj, data in pairs(ActiveEspDrawings) do
			if not foundEggs[obj] or not obj.Parent then
				if data.Drawing then data.Drawing:Remove() end
				ActiveEspDrawings[obj] = nil
			end
		end

		for obj, _ in pairs(foundEggs) do
			if not ActiveEspDrawings[obj] then
				local textDraw = Drawing.new("Text")
				textDraw.Visible = false
				textDraw.Center = true
				textDraw.Outline = true
				textDraw.Font = Drawing.Fonts.UI
				textDraw.Size = 15
				textDraw.Color = Color3.fromRGB(255, 230, 0)
				ActiveEspDrawings[obj] = { Drawing = textDraw }
			end
		end
	end
end)

RunService.RenderStepped:Connect(function()
	if not Config.ESPEnabled then return end

	local char = LocalPlayer.Character
	local rootPart = char and char:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end

	for obj, data in pairs(ActiveEspDrawings) do
		if obj and obj.Parent then
			local screenPos, onScreen = Camera:WorldToViewportPoint(obj.Position + Vector3.new(0, 2, 0))
			if onScreen then
				local distance = (rootPart.Position - obj.Position).Magnitude
				data.Drawing.Position = Vector2.new(screenPos.X, screenPos.Y)
				data.Drawing.Text = string.format("[Egg]\n%dm", math.floor(distance))
				data.Drawing.Visible = true
			else
				data.Drawing.Visible = false
			end
		end
	end
end)
