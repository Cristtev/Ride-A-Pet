-- Professional Slider Creator Function
local function createSlider(name, defaultVal, posY, callback)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.85, 0, 0, 18)
	label.Position = UDim2.new(0.075, 0, posY, 0)
	label.BackgroundTransparency = 1
	label.Text = string.format("%s: %d", name, defaultVal)
	label.TextColor3 = Color3.fromRGB(200, 200, 200)
	label.TextSize = 11
	label.Font = Enum.Font.SourceSansBold
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = ScrollContainer

	local bgBar = Instance.new("Frame")
	bgBar.Size = UDim2.new(0.85, 0, 0, 22)
	bgBar.Position = UDim2.new(0.075, 0, posY + 0.045, 0)
	bgBar.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	bgBar.BorderSizePixel = 0
	bgBar.Parent = ScrollContainer

	local barCorner = Instance.new("UICorner")
	barCorner.CornerRadius = UDim.new(0, 5)
	barCorner.Parent = bgBar

	local fillBar = Instance.new("Frame")
	fillBar.Size = UDim2.new(defaultVal / 500, 0, 1, 0)
	fillBar.BackgroundColor3 = Color3.fromRGB(60, 120, 200)
	fillBar.BorderSizePixel = 0
	fillBar.Parent = bgBar

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0, 5)
	fillCorner.Parent = fillBar

	local textBox = Instance.new("TextBox")
	textBox.Size = UDim2.new(0, 60, 1, 0)
	textBox.Position = UDim2.new(1, -65, 0, 0)
	textBox.BackgroundTransparency = 1
	textBox.Text = tostring(defaultVal)
	textBox.PlaceholderText = "0-500"
	textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	textBox.TextSize = 11
	textBox.Font = Enum.Font.SourceSansBold
	textBox.Parent = bgBar

	local draggingSlider = false
	
	bgBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			draggingSlider = true
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			draggingSlider = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local relativeX = math.clamp((input.Position.X - bgBar.AbsolutePosition.X) / bgBar.AbsoluteSize.X, 0, 1)
			local calculatedVal = math.floor(relativeX * 500)
			fillBar.Size = UDim2.new(relativeX, 0, 1, 0)
			textBox.Text = tostring(calculatedVal)
			label.Text = string.format("%s: %d", name, calculatedVal)
			callback(calculatedVal)
		end
	end)

	textBox.FocusLost:Connect(function()
		local parsedVal = tonumber(textBox.Text)
		if parsedVal then
			parsedVal = math.clamp(parsedVal, 0, 500)
			textBox.Text = tostring(parsedVal)
			fillBar.Size = UDim2.new(parsedVal / 500, 0, 1, 0)
			label.Text = string.format("%s: %d", name, parsedVal)
			callback(parsedVal)
		else
			textBox.Text = tostring(defaultVal)
		end
	end)
end

